# AI DJ (required for chat)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
TAVILY_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# Upstash Redis (required)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional cache tuning (minimum 1000 ms; defaults to 5000 ms)
UPSTASH_DB_CACHE_TTL_MS=

# Cloudflare R2 media storage (required)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom public domain; without it, the server R2 proxy is used
R2_PUBLIC_DOMAIN=

# Public application origin for shared-track metadata (optional)
PUBLIC_BASE_URL=
