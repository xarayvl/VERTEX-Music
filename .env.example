# AI DJ (required for chat)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
TAVILY_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# Upstash Redis (required)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required AES-256-GCM key (generate with: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=
# Persist at most this many days of chat history (default 30, maximum 365)
CHAT_RETENTION_DAYS=30
# Recovery snapshot lifetime in Redis seconds (default 7 days, maximum 90 days)
DB_BACKUP_TTL_SECONDS=604800
# Optional cache tuning (minimum 1000 ms; defaults to 5000 ms)
# This affects process memory only; it is not a Redis retention setting.
UPSTASH_DB_CACHE_TTL_MS=

# Login session limits (defaults: 30 days absolute, 24 hours idle)
SESSION_ABSOLUTE_TTL_SECONDS=
SESSION_IDLE_TTL_SECONDS=

# Cloudflare R2 media storage (required)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Single bucket used for all managed images and audio.
R2_BUCKET_NAME=
# Per-account managed upload quota and individual audio cap (bytes)
USER_STORAGE_QUOTA_BYTES=2147483648
MAX_AUDIO_UPLOAD_BYTES=104857600
# Do not configure R2_PRIVATE_BUCKET_NAME or R2_PUBLIC_DOMAIN. Upload, verify,
# image/audio reads, and deletion all use only R2_BUCKET_NAME.

# Canonical public origin for HTTPS redirects, social metadata, and cookie-CSRF
# Origin checks. Required in production and must be an origin-only HTTPS URL.
# Example: https://vertex.example
PUBLIC_BASE_URL=
