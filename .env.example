# AI DJ (required for chat)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
TAVILY_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# HttpOnly session lifetime (defaults: 7 days absolute, 24 hours idle)
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400

# Upstash Redis (required for application data, sessions, and admin error logs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_DB_CACHE_TTL_MS=
# Set to 1 only for an intentional first-time creation of an empty canonical DB.
ALLOW_EMPTY_DATABASE_INIT=

# Cloudflare R2 media storage (required for uploaded media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom public domain; the same-origin R2 proxy is used when omitted.
R2_PUBLIC_DOMAIN=

# Canonical HTTPS origin for metadata and same-origin CSRF enforcement
PUBLIC_BASE_URL=
