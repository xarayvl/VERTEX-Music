# AI DJ (required for chat)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
TAVILY_API_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# HttpOnly session lifetime (defaults: 7 days absolute, 24 hours idle)
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_DB_CACHE_TTL_MS=

# Optional local fallback path for the redacted admin error log
VERTEX_ERROR_LOG_FILE=

# Cloudflare R2 media storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Canonical HTTPS origin for metadata and same-origin CSRF enforcement
PUBLIC_BASE_URL=
